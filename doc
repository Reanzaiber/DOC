        let currentCategory = 'all';
        let searchQuery = '';
        let nextId = 13;

        // Render jobs
        function renderJobs() {
            const grid = document.getElementById('jobsGrid');
            const filtered = jobs.filter(job => {
                const matchesCategory = currentCategory === 'all' || job.category === currentCategory;
                const q = searchQuery.toLowerCase();
                const matchesSearch = !q ||
                    job.title.toLowerCase().includes(q) ||
                    job.company.toLowerCase().includes(q) ||
                    job.description.toLowerCase().includes(q) ||
                    job.location.toLowerCase().includes(q) ||
                    job.tags.some(t => t.toLowerCase().includes(q));
                return matchesCategory && matchesSearch;
            });

            document.getElementById('jobCount').textContent =
                `${filtered.length} position${filtered.length !== 1 ? 's' : ''} found`;

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="empty-state">
                        <h3>No positions found</h3>
                        <p>Try a different role, specialty, or facility name</p>
                    </div>`;
                return;
            }

            grid.innerHTML = filtered.map(job => `
                <div class="job-card">
                    <div class="job-card-header">
                        <div>
                            <div class="job-title">${escapeHtml(job.title)}</div>
                            <div class="facility">🏥 ${escapeHtml(job.company)}</div>
                        </div>
                        ${job.salary ? `<div class="salary">${escapeHtml(job.salary)}</div>` : ''}
                    </div>
                    <p class="job-description">${escapeHtml(job.description)}</p>
                    <div class="job-tags">
                        ${job.tags.map(tag => `<span class="tag">${escapeHtml(tag)}</span>`).join('')}
                    </div>
                    <div class="job-footer">
                        <div class="job-meta">
                            <span>📍 ${escapeHtml(job.location || 'Not specified')}</span>
                            <span>💼 ${escapeHtml(job.type || 'Full-time')}</span>
                            <span>👥 ${job.positions || 1} position${(job.positions || 1) > 1 ? 's' : ''}</span>
                            <span>🕒 ${escapeHtml(job.date)}</span>
                        </div>
                        <button class="apply-btn" onclick="applyJob(${job.id})">Apply</button>
                    </div>
                </div>
            `).join('');
        }

        function escapeHtml(str) {
            const div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        function filterJobs() {
            searchQuery = document.getElementById('searchInput').value;
            renderJobs();
        }

        function setCategory(category, btn) {
            currentCategory = category;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderJobs();
        }

        function applyJob(id) {
            const job = jobs.find(j => j.id === id);
            alert(`Application submitted for "${job.title}"\nFacility: ${job.company}\n\n(In a real app, this would open an application form with credential upload.)`);
        }

        // Modal
        function openModal() {
            document.getElementById('jobModal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('jobModal').classList.remove('active');
            document.getElementById('jobForm').reset();
        }

        function submitJob(e) {
            e.preventDefault();
            const tagsInput = document.getElementById('jobTags').value;
            const positions = parseInt(document.getElementById('jobPositions').value) || 1;
            const newJob = {
                id: nextId++,
                title: document.getElementById('jobTitle').value.trim(),
                company: document.getElementById('jobCompany').value.trim(),
                category: document.getElementById('jobCategory').value,
                location: document.getElementById('jobLocation').value.trim(),
                salary: document.getElementById('jobSalary').value.trim(),
                type: document.getElementById('jobType').value,
                positions: positions,
                description: document.getElementById('jobDescription').value.trim(),
                tags: tagsInput ? tagsInput.split(',').map(t => t.trim()).filter(Boolean) : [],
                date: "Just now"
            };
            jobs.unshift(newJob);
            closeModal();
            renderJobs();
            window.scrollTo({ top: 0, behavior: 'smooth' });
            setTimeout(() => alert(`Job "${newJob.title}" at ${newJob.company} posted successfully!`), 300);
        }

        // Close modal on overlay click
        document.getElementById('jobModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        // Initial render
        renderJobs();
    </script>
</body>
</html>













































































































